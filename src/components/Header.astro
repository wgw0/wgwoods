---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="page">
	<a class="name" href="/">{SITE_TITLE}</a>
	<nav aria-label="Main">
		<HeaderLink href="/blog">Writing</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
	</nav>
	<svg class="wave" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
		<path d="M4 4 C 50 34, 210 40, 400 24 S 720 0, 860 8 S 962 30, 996 36" />
	</svg>
</header>
<style>
	header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
		padding-top: var(--space-8);
	}
	.name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step--1);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--ink);
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: var(--space-6);
	}
	.wave {
		flex-basis: 100%;
		width: 100%;
		height: 2.5rem;
		margin-top: var(--space-3);
		overflow: visible;
	}
	.wave path {
		fill: none;
		stroke: var(--wave);
		stroke-width: 2.5;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}
</style>
