---
// Google Tag Manager: the page-context dataLayer push followed by the container loader.
// Goes at the top of <head>, so page data is in the dataLayer before gtm.js reads it.
// Tracking only runs in production builds (astro build / preview), never in `astro dev`.
import { GTM_ID, GTM_PATH } from '../consts';

export type PageData = {
	page_type: string;
	content_group: string;
	article_id?: string;
	article_title?: string;
	article_publish_date?: string;
	article_reading_minutes?: number;
	traffic_type?: 'internal';
};

interface Props {
	page: PageData;
}

const { page } = Astro.props;
const enabled = Boolean(GTM_ID) && import.meta.env.PROD;
// Through Cloudflare's tag gateway the container loads from our own domain, so blockers keyed on
// googletagmanager.com or "gtm.js" don't stop it.
const src = GTM_PATH ? `${GTM_PATH}/?id=` : 'https://www.googletagmanager.com/gtm.js?id=';
---

{
	enabled && (
		<script is:inline define:vars={{ gtmId: GTM_ID, page, src }}>
			// Internal traffic: visit any page with ?internal=1 once per browser to mark it as ours
			// (?internal=0 undoes it). Anything not on the live domain, e.g. a localhost preview, is
			// always internal. GA4's Internal Traffic data filter drops hits with traffic_type=internal.
			try {
				var flag = new URLSearchParams(location.search).get('internal');
				if (flag === '1') localStorage.setItem('wg_internal', '1');
				if (flag === '0') localStorage.removeItem('wg_internal');
				if (localStorage.getItem('wg_internal') === '1') page.traffic_type = 'internal';
			} catch (e) {}
			if (location.hostname !== 'wgwoods.co.uk') page.traffic_type = 'internal';
			window.dataLayer = window.dataLayer || [];
			window.dataLayer.push(page);
			// The same fields as a gtag 'set' command, which the GA4 Google tag applies to every event
			// it sends, page_view and enhanced measurement included. GTM's own settings only reach
			// the events its GA4 event tags send.
			function gtag() {
				window.dataLayer.push(arguments); // gtag only reads real arguments objects, not arrays
			}
			gtag('set', page);
			gtag('set', 'send_page_view', false);
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = src + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', gtmId);
		</script>
	)
}
