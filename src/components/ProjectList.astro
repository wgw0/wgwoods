---
import type { Project } from '../data/projects';
interface Props {
	projects: Project[];
}
const { projects } = Astro.props;
---

<ul class="projects">
	{
		projects.map((project) => (
			<li>
				<h3>
					{project.url ? <a href={project.url}>{project.title}</a> : project.title}
				</h3>
				<p>{project.description}</p>
				{project.status && <p class="status">{project.status}</p>}
			</li>
		))
	}
</ul>
<style>
	.projects {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-8);
	}
	h3 {
		font-size: var(--step-1);
	}
	h3 a {
		color: var(--ink);
	}
	h3 a:hover {
		color: var(--accent);
	}
	p {
		margin-top: var(--space-1);
		color: var(--ink-soft);
		max-width: var(--measure);
	}
	.status {
		font-size: var(--step--1);
		color: var(--accent);
	}
</style>
