---
import { LINKEDIN_URL, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title={`About | ${SITE_TITLE}`} description="A little about Will Woods.">
	<h1>About</h1>
	<div class="prose">
		<p>
			I'm Will Woods. I write about organisations, people and how they change, with a lens on
			defence and security.
		</p>
		<p>
			I've advised the MoD and spoken on organisational culture, and I'm interested in what makes
			transformation stick amid geopolitics and procurement. This site is where I keep my writing
			and the things I build.
		</p>
		<p>
			You can reach me at <a href="mailto:hello@wgwoods.co.uk">hello@wgwoods.co.uk</a> or on
			<a href={LINKEDIN_URL}>LinkedIn</a>.
		</p>
	</div>
</Base>

<style>
	.prose {
		margin-top: var(--space-8);
	}
</style>
