---
// Cloudflare Pages serves this for any address that doesn't exist, with a real 404 status.
import { SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title={`Page not found | ${SITE_TITLE}`} description="This page doesn't exist." noindex>
	<section class="missing">
		<p class="code">404</p>
		<h1>This page doesn't exist.</h1>
		<p class="lede">The link may be old or mistyped.</p>
		<a class="button" href="/">Back to home page</a>
		<p class="alt">Or browse <a href="/blog">all writing</a>.</p>
	</section>
</Base>

<style>
	.missing {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-block: var(--space-16) var(--space-8);
	}
	.code {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		letter-spacing: 0.2em;
		color: var(--ink-soft);
	}
	h1 {
		margin-top: var(--space-4);
		font-size: var(--step-4);
		max-width: 16ch;
	}
	h1::after {
		content: '';
		display: block;
		width: 3rem;
		height: 2px;
		margin: var(--space-6) auto 0;
		background: var(--gold);
	}
	.lede {
		margin-top: var(--space-6);
		color: var(--ink-soft);
		font-size: var(--step-1);
	}
	.button {
		margin-top: var(--space-10);
		display: inline-block;
		padding: 1.125rem var(--space-12);
		border-radius: 999px;
		background: var(--ink);
		color: var(--canvas);
		font-weight: 600;
		font-size: 1.25rem;
		text-decoration: none;
		box-shadow: inset 0 -2px 0 var(--gold);
		transition: background-color 150ms var(--ease-out), transform 150ms var(--ease-out);
	}
	.button:hover {
		background: var(--accent);
		color: var(--canvas);
		transform: translateY(-1px);
	}
	.alt {
		margin-top: var(--space-6);
		color: var(--ink-soft);
		font-size: var(--step--1);
	}
</style>
