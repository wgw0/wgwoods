---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { projects } from '../data/projects';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>I write about AI, analytics, and the small tools I build along the way.</h1>
		<p>
			I'm Will Woods. By day I work on measurement and tracking; the rest of the time I'm testing
			what AI can actually do and writing down what I find.
		</p>
	</section>

	<section aria-labelledby="writing">
		<div class="section-head">
			<h2 id="writing">Writing</h2>
			<a href="/blog">All writing</a>
		</div>
		<PostList posts={posts} />
	</section>

	<section aria-labelledby="projects">
		<div class="section-head">
			<h2 id="projects">Projects</h2>
			<a href="/projects">All projects</a>
		</div>
		<ProjectList projects={projects.slice(0, 3)} />
	</section>
</Base>

<style>
	.intro {
		padding-block: var(--space-12) var(--space-16);
		animation: arrive 800ms var(--ease-out) both;
	}
	.intro h1 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: var(--step-4);
		line-height: 1.12;
		letter-spacing: -0.02em;
		max-width: 20ch;
	}
	.intro p {
		margin-top: var(--space-6);
		font-size: var(--step-1);
		color: var(--ink-soft);
		max-width: 52ch;
	}
	section + section {
		margin-top: var(--space-16);
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-6);
	}
	.section-head a {
		font-size: var(--step--1);
	}
	@keyframes arrive {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}
</style>
